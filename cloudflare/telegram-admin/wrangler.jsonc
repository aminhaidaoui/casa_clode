{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-nostra-telegram",
  "main": "src/index.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://aminhaidaoui.github.io",
    "PUBLIC_BASE_URL": "https://casa-nostra-telegram.aminhaidaoui1.workers.dev",
    "PUBLIC_SITE_URL": "https://aminhaidaoui.github.io/casa_clode/#pensieriDiOggi",
    "VAPID_SUBJECT": "https://aminhaidaoui.github.io/casa_clode/"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "3c0aed330f7c49198ec37e5e29b80bf1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casa-nostra-admin",
      "database_id": "5901c328-2eff-4ec4-a45c-0425d5aac9a4",
      "migrations_dir": "migrations"
    }
  ]
}
