{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-nostra-telegram",
  "main": "src/index.js",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://aminhaidaoui.github.io",
    "PUBLIC_BASE_URL": "https://casa-nostra-telegram.aminhaidaoui1.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "3c0aed330f7c49198ec37e5e29b80bf1"
    }
  ]
}
